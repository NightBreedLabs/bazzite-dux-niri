    window-rule {
        geometry-corner-radius 20 // Set every window radius to 20
        clip-to-geometry true
    }

    window-rule {
        background-effect {
          blur true
          xray false
        }
    }

    // Floating Noctalia settings window.
    window-rule {
        match app-id="dev.noctalia.Noctalia"
        open-floating true
        default-column-width { fixed 1080; }
        default-window-height { fixed 920; }
    }

    // if you use steam you will probably like these
    window-rule {
        match app-id="steam"
        exclude title=r#"^[Ss]team$"#
        open-floating true
    }

    window-rule {
       match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
       default-floating-position x=10 y=10 relative-to="bottom-right"
       open-focused false
    }


    // Steam Big Picture: fullscreen instead of floating/centered
    window-rule {
        match app-id="steam" title=r#"^Steam Big Picture Mode$"#
        open-floating false
        open-fullscreen true
    }

    // Hide xwaylandvideobridge dummy windows if ever launched
    window-rule {
        match app-id="xwaylandvideobridge"
        open-floating true
        open-focused false
        opacity 0.0
        default-floating-position x=-100 y=-100 relative-to="top-left"
        default-column-width { fixed 1; }
        default-window-height { fixed 1; }
    }

    // Antigravity AGY floating HUD
    window-rule {
        match app-id="^agy-terminal$"
        open-floating true
        geometry-corner-radius 16
        clip-to-geometry true
        default-column-width { fixed 1100; }
        default-window-height { fixed 720; }
    }

    // FileBot: Main window width (66%) & floating child dialogs
    window-rule {
        match app-id="net-filebot-Main" title=r#"^FileBot \d+"#
        default-column-width { proportion 0.66667; }
    }

    window-rule {
        match app-id="net-filebot-Main"
        exclude title=r#"^FileBot \d+"#
        open-floating true
    }

    // Zenity file choosers and dialogs
    window-rule {
        match app-id="zenity"
        open-floating true
    }

    // Calculator (KCalc)
    window-rule {
        match app-id="org.kde.kcalc"
        open-floating true
    }

    // Desktop portal dialogs and file pickers (Brave, Chrome, Firefox, Floorp)
    window-rule {
        match app-id=r#"^xdg-desktop-portal-.*"#
        open-floating true
    }

    layer-rule {
        match namespace="^noctalia-wallpaper"
        place-within-backdrop true
    }

    layer-rule {
        match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
        background-effect {
          xray false
          // blur false
        }
    }

    // ─── Dux Shell (DMS) Layer Rules ───
    layer-rule {
        match namespace="^quickshell$"
        place-within-backdrop true
    }

    layer-rule {
        match namespace="dms:blurwallpaper"
        place-within-backdrop true
    }
